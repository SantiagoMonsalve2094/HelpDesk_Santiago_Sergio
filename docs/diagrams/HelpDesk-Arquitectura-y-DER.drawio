    <mxCell id="erd-edge-5" value="clasifica" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;" edge="1" source="support-categories" target="tickets" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="erd-edge-7" value="asignaciones" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;" edge="1" source="tickets" target="ticket-assignments" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="erd-edge-9" value="comentarios" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;" edge="1" source="tickets" target="ticket-comments" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="erd-edge-11" value="estados" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;" edge="1" source="tickets" target="ticket-status-history" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="erd-edge-13" value="ciclos SLA" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;" edge="1" source="tickets" target="ticket-sla-cycles" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="erd-edge-15" value="genera número" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;dashed=1;strokeColor=#666666;" edge="1" source="ticket-number-sequences" target="tickets" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="erd-legend" value="PK: clave primaria   FK: clave foránea   UK: restricción única   CK: check constraint. Las FK de auditoría hacia USERS usan NoAction para preservar los historiales. Los hijos del agregado Ticket se eliminan en cascada únicamente si el propietario se elimina físicamente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="500" y="1190" width="1080" height="65" as="geometry"/></mxCell>
  </root>
</mxGraphModel></diagram>
  <diagram id="helpdesk-architecture" name="Arquitectura"><mxGraphModel dx="1900" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1050" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
