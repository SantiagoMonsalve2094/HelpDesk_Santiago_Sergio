  <diagram id="helpdesk-erd" name="DER"><mxGraphModel dx="1900" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1320" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="erd-title" value="HelpDesk - Diagrama entidad-relación" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell>
    <mxCell id="erd-note" value="Modelo físico implementado con EF Core 8.0.11 y SQL Server. Incluye tablas, tipos principales, claves, restricciones únicas, rowversion, soft delete y consecutivo anual transaccional." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="50" as="geometry"/></mxCell>
    <mxCell id="users" value="USERS" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="360" height="330" as="geometry"/></mxCell>
    <mxCell id="users-fields" value="PK  id : uniqueidentifier&#xa;UK  email : nvarchar(254)&#xa;     full_name : nvarchar(200)&#xa;     password_hash : nvarchar(500)&#xa;     role : nvarchar(20)&#xa;     is_active : bit&#xa;FK? supervisor_support_category_id : uniqueidentifier?&#xa;     technician_max_active_tickets : int?&#xa;     created_at_utc : datetimeoffset&#xa;     updated_at_utc : datetimeoffset&#xa;     row_version : rowversion&#xa;&#xa;CK: rol coherente con perfil y capacidad positiva." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="users"><mxGeometry x="8" y="42" width="344" height="276" as="geometry"/></mxCell>
    <mxCell id="technician-categories" value="TECHNICIAN_CATEGORIES" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1"><mxGeometry x="470" y="180" width="310" height="175" as="geometry"/></mxCell>
    <mxCell id="technician-categories-fields" value="PK, FK  technician_user_id : uniqueidentifier&#xa;PK, FK  support_category_id : uniqueidentifier&#xa;&#xa;Relación N:M normalizada para las categorías que puede atender cada técnico." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="technician-categories"><mxGeometry x="8" y="42" width="294" height="121" as="geometry"/></mxCell>
    <mxCell id="support-categories" value="SUPPORT_CATEGORIES" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;" vertex="1" parent="1"><mxGeometry x="850" y="150" width="350" height="280" as="geometry"/></mxCell>
    <mxCell id="support-categories-fields" value="PK  id : uniqueidentifier&#xa;UK  name : nvarchar(100)&#xa;     description : nvarchar(1000)&#xa;     is_active : bit&#xa;     created_at_utc : datetimeoffset&#xa;     updated_at_utc : datetimeoffset&#xa;     row_version : rowversion&#xa;&#xa;Las categorías utilizadas se desactivan; no se eliminan." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="support-categories"><mxGeometry x="8" y="42" width="334" height="226" as="geometry"/></mxCell>
    <mxCell id="sla-policies" value="SLA_POLICIES" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1"><mxGeometry x="1280" y="180" width="330" height="205" as="geometry"/></mxCell>
    <mxCell id="sla-policies-fields" value="PK  id : uniqueidentifier&#xa;FK  support_category_id : uniqueidentifier&#xa;UK  priority : nvarchar(20)&#xa;     response_time_ticks : bigint&#xa;&#xa;UK compuesto: categoría + prioridad.&#xa;CK: response_time_ticks &gt; 0." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="sla-policies"><mxGeometry x="8" y="42" width="314" height="151" as="geometry"/></mxCell>
    <mxCell id="ticket-assignments" value="TICKET_ASSIGNMENTS" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="380" height="260" as="geometry"/></mxCell>
    <mxCell id="ticket-assignments-fields" value="PK  id : uniqueidentifier&#xa;FK  ticket_id : uniqueidentifier&#xa;FK  technician_user_id : uniqueidentifier&#xa;FK  assigned_by_user_id : uniqueidentifier&#xa;     assigned_at_utc : datetimeoffset&#xa;     ended_at_utc : datetimeoffset?&#xa;     reason : nvarchar(1000)?&#xa;&#xa;Conserva el historial completo de asignaciones." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="ticket-assignments"><mxGeometry x="8" y="42" width="364" height="206" as="geometry"/></mxCell>
    <mxCell id="tickets" value="TICKETS" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1"><mxGeometry x="510" y="500" width="440" height="410" as="geometry"/></mxCell>
    <mxCell id="tickets-fields" value="PK  id : uniqueidentifier&#xa;UK  ticket_number : nvarchar(14)&#xa;     subject : nvarchar(200)&#xa;     description : nvarchar(4000)&#xa;FK  creator_user_id : uniqueidentifier&#xa;FK  support_category_id : uniqueidentifier&#xa;     priority : nvarchar(20)&#xa;     status : nvarchar(20)&#xa;FK? current_technician_user_id : uniqueidentifier?&#xa;     is_deleted : bit&#xa;     created_at_utc : datetimeoffset&#xa;     updated_at_utc : datetimeoffset&#xa;     resolved_at_utc : datetimeoffset?&#xa;     closed_at_utc : datetimeoffset?&#xa;     row_version : rowversion&#xa;&#xa;Filtro global: is_deleted = 0." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="tickets"><mxGeometry x="8" y="42" width="424" height="356" as="geometry"/></mxCell>
    <mxCell id="ticket-number-sequences" value="TICKET_NUMBER_SEQUENCES" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1"><mxGeometry x="1040" y="500" width="320" height="175" as="geometry"/></mxCell>
    <mxCell id="ticket-number-sequences-fields" value="PK  year : int&#xa;     last_value : int&#xa;&#xa;CK: year entre 2000 y 9999.&#xa;CK: last_value entre 0 y 999999.&#xa;Reserva con transacción Serializable, UPDLOCK y HOLDLOCK." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="ticket-number-sequences"><mxGeometry x="8" y="42" width="304" height="121" as="geometry"/></mxCell>
    <mxCell id="ticket-sla-cycles" value="TICKET_SLA_CYCLES" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1"><mxGeometry x="1440" y="480" width="420" height="390" as="geometry"/></mxCell>
    <mxCell id="ticket-sla-cycles-fields" value="PK  id : uniqueidentifier&#xa;FK  ticket_id : uniqueidentifier&#xa;FK  support_category_id : uniqueidentifier&#xa;     trigger : nvarchar(30)&#xa;     priority : nvarchar(20)&#xa;     duration_ticks : bigint&#xa;     started_at_utc : datetimeoffset&#xa;     deadline_at_utc : datetimeoffset&#xa;     responded_at_utc : datetimeoffset?&#xa;     breached_at_utc : datetimeoffset?&#xa;FK? responsible_technician_user_id : uniqueidentifier?&#xa;     outcome : nvarchar(20)&#xa;&#xa;CK: duration_ticks &gt; 0. Reasignar no reinicia el ciclo." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="ticket-sla-cycles"><mxGeometry x="8" y="42" width="404" height="336" as="geometry"/></mxCell>
    <mxCell id="ticket-comments" value="TICKET_COMMENTS" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="380" height="260" as="geometry"/></mxCell>
    <mxCell id="ticket-comments-fields" value="PK  id : uniqueidentifier&#xa;FK  ticket_id : uniqueidentifier&#xa;FK  author_user_id : uniqueidentifier&#xa;     type : nvarchar(40)&#xa;     body : nvarchar(4000)&#xa;     satisfies_resolution_requirement : bit&#xa;     created_at_utc : datetimeoffset" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="ticket-comments"><mxGeometry x="8" y="42" width="364" height="206" as="geometry"/></mxCell>
    <mxCell id="ticket-status-history" value="TICKET_STATUS_HISTORY" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1"><mxGeometry x="1010" y="830" width="410" height="290" as="geometry"/></mxCell>
    <mxCell id="ticket-status-history-fields" value="PK  id : uniqueidentifier&#xa;FK  ticket_id : uniqueidentifier&#xa;     previous_status : nvarchar(20)?&#xa;     new_status : nvarchar(20)&#xa;FK? changed_by_user_id : uniqueidentifier?&#xa;     reason : nvarchar(1000)?&#xa;     is_automatic : bit&#xa;     changed_at_utc : datetimeoffset" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="ticket-status-history"><mxGeometry x="8" y="42" width="394" height="236" as="geometry"/></mxCell>
    <mxCell id="erd-edge-1" value="habilita" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;" edge="1" source="users" target="technician-categories" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
