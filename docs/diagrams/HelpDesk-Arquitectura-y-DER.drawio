    <mxCell id="arch-title" value="HelpDesk - Arquitectura por capas" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell>
    <mxCell id="arch-subtitle" value=".NET 8 + React + SQL Server | DDD, Clean Architecture y CQRS con MediatR" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1100" height="30" as="geometry"/></mxCell>
    <mxCell id="actors" value="Usuarios internos" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="230" height="310" as="geometry"/></mxCell>
    <mxCell id="actor-user" value="Usuario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="actors"><mxGeometry x="35" y="55" width="160" height="45" as="geometry"/></mxCell>
    <mxCell id="actor-technician" value="Técnico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="actors"><mxGeometry x="35" y="115" width="160" height="45" as="geometry"/></mxCell>
