    <mxCell id="arch-edge-4" value="orquesta agregados" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" source="application" target="domain" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="arch-edge-5" value="implementa puertos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#9673a6;strokeWidth=2;" edge="1" source="infrastructure" target="application" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="arch-edge-6" value="mapea agregados" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#9673a6;strokeWidth=2;" edge="1" source="infrastructure" target="domain" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
