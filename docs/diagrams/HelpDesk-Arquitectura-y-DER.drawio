    <mxCell id="actor-admin" value="SuperAdmin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="actors"><mxGeometry x="35" y="235" width="160" height="45" as="geometry"/></mxCell>
    <mxCell id="frontend" value="Frontend - Planificado" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="340" y="240" width="280" height="200" as="geometry"/></mxCell>
    <mxCell id="react-spa" value="React SPA&#xa;&#xa;Vistas por rol&#xa;Tickets propios y asignados&#xa;Reportes de SLA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;" vertex="1" parent="frontend"><mxGeometry x="35" y="55" width="210" height="115" as="geometry"/></mxCell>
    <mxCell id="backend" value="Backend HelpDesk - .NET 8" style="swimlane;startSize=38;html=1;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="900" height="730" as="geometry"/></mxCell>
    <mxCell id="presentation" value="Presentation / API&#xa;Planificado" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;dashed=1;" vertex="1" parent="backend"><mxGeometry x="40" y="70" width="220" height="180" as="geometry"/></mxCell>
    <mxCell id="presentation-detail" value="ASP.NET Core API&#xa;Controladores delgados&#xa;JWT / autorización&#xa;OpenAPI&#xa;Composition root / DI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="presentation"><mxGeometry x="20" y="50" width="180" height="105" as="geometry"/></mxCell>
    <mxCell id="application" value="Application - Implementado" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;strokeWidth=2;" vertex="1" parent="backend"><mxGeometry x="320" y="70" width="250" height="270" as="geometry"/></mxCell>
    <mxCell id="application-detail" value="CQRS + MediatR 14&#xa;FluentValidation 12&#xa;&#xa;Features: usuarios, categorías y tickets&#xa;Commands, Queries y Handlers&#xa;Puertos de escritura y lectura&#xa;Unit of Work, reloj, hashing y consecutivo&#xa;Jobs expresados como casos de uso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="application"><mxGeometry x="20" y="50" width="210" height="190" as="geometry"/></mxCell>
    <mxCell id="domain" value="Domain - Implementado" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;strokeWidth=2;" vertex="1" parent="backend"><mxGeometry x="630" y="70" width="230" height="300" as="geometry"/></mxCell>
    <mxCell id="domain-detail" value="Agregados&#xa;Ticket, User, SupportCategory&#xa;&#xa;Entities y Value Objects&#xa;Políticas de dominio&#xa;Invariantes de negocio&#xa;Domain Events&#xa;SLA e historiales" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="domain"><mxGeometry x="18" y="50" width="194" height="220" as="geometry"/></mxCell>
    <mxCell id="jobs" value="Ejecución de jobs&#xa;Planificada" style="swimlane;startSize=44;html=1;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;dashed=1;" vertex="1" parent="backend"><mxGeometry x="40" y="430" width="220" height="180" as="geometry"/></mxCell>
    <mxCell id="jobs-detail" value="Scheduler pendiente&#xa;&#xa;Application ya expone:&#xa;Evaluar SLA pendiente&#xa;Cerrar resueltos a las 48 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="jobs"><mxGeometry x="20" y="60" width="180" height="95" as="geometry"/></mxCell>
    <mxCell id="infrastructure" value="Infrastructure - Implementado" style="swimlane;startSize=34;html=1;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;strokeWidth=2;" vertex="1" parent="backend"><mxGeometry x="300" y="390" width="330" height="280" as="geometry"/></mxCell>
    <mxCell id="infrastructure-detail" value="EF Core 8.0.11 + SQL Server&#xa;DbContext y configuraciones Fluent&#xa;Repository + Unit of Work&#xa;Lecturas CQRS AsNoTracking&#xa;Secuencia anual transaccional&#xa;PBKDF2 + reloj UTC&#xa;Migración inicial y rowversion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="infrastructure"><mxGeometry x="25" y="50" width="280" height="200" as="geometry"/></mxCell>
    <mxCell id="automated-tests" value="Pruebas automatizadas&#xa;90 pruebas aprobadas&#xa;&#xa;Domain: 30&#xa;Application: 44&#xa;Infrastructure: 16 con LocalDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="backend"><mxGeometry x="660" y="430" width="200" height="155" as="geometry"/></mxCell>
    <mxCell id="database" value="SQL Server&#xa;Adaptador y migración implementados&#xa;Base permanente pendiente" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1680" y="390" width="180" height="135" as="geometry"/></mxCell>
    <mxCell id="arch-edge-1" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" source="actors" target="frontend" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
